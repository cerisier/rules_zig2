"""Build file for the e2e translate-c repository."""

load("@rules_zig//zig:defs.bzl", "zig_binary")
load("@rules_zig//zig/translate-c:toolchain.bzl", "translate_c_runtime_module")

translate_c_runtime_module(
    name = "c_builtins",
    main = "lib/c_builtins.zig",
    visibility = ["//visibility:public"],
)

translate_c_runtime_module(
    name = "helpers",
    main = "lib/helpers.zig",
    visibility = ["//visibility:public"],
)

zig_binary(
    name = "translate-c",
    data = glob(["lib/**/*.zig"]),
    srcs = glob(["src/**/*.zig"]),
    main = "src/main.zig",
    linkopts = ["-lc"],
    visibility = ["//visibility:public"],
    deps = [
        ":c_builtins",
        ":helpers",
        "@arocc//:aro",
    ],
)
